# Kopiraj u .env i popuni. Nikad ne komituj pravi ključ.

# Numista API ključ (numista.com -> API -> "Activate API access").
# Ako nije postavljen, aplikacija koristi ugrađeni probni katalog (Jugoslavija).
NUMISTA_API_KEY=

# Putanja do SQLite baze (podrazumijevano data/numizmatika.db).
DATABASE_URL="file:./data/numizmatika.db"

# Koliko poziva GET /types/{id} (detalji, valuta) aplikacija smije potrošiti po otvaranju albuma.
NUMISTA_DETAIL_BUDGET=100

# Mjesečna kvota tvog Numista plana (besplatni plan: 2000).
NUMISTA_MONTHLY_QUOTA=2000

# Port dev servera (neuobičajen da ne smeta drugim aplikacijama).
PORT=4317
